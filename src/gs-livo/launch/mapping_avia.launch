<launch>
<!-- Launch file for Livox AVIA LiDAR -->

	<arg name="rviz" default="true" />
	<arg name="config" default="$(find fast_livo)/config/avia.yaml" />  <!-- e.g. config/scene_data.yaml -->
	<arg name="camera" default="$(find fast_livo)/config/camera_pinhole.yaml" />

	<rosparam command="load" file="$(arg config)" />
	<arg name="save_ply" default="" />  <!-- write the Gaussian map (3DGS PLY) on shutdown -->
	<param name="gs/save_ply" value="$(arg save_ply)" />
	<arg name="depth_completion" default="false" />
	<arg name="dc_engine" default="" />
	<param name="gs/dc_en" value="$(arg depth_completion)" />
	<param name="gs/dc_engine" value="$(arg dc_engine)" />

	<node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
		<rosparam file="$(arg camera)" />
	</node>
	
	<group if="$(arg rviz)">
		<node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
	</group>
	
	<node pkg="image_transport" type="republish" name="republish" args="compressed in:=/left_camera/image raw out:=/left_camera/image" output="screen" respawn="true"/>

 launch-prefix="gdb -ex run --args"
launch-prefix="valgrind --leak-check=full"
</launch> 	
